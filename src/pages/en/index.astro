---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import RecentPosts from '../../components/RecentPosts.astro';
import { getPublishedPosts } from '../../lib/content';
import { SITE } from '../../lib/routes';

const posts = await getPublishedPosts('en');
---

<BaseLayout title={`${SITE.name} | Home`} description={SITE.description} path="/en/" lang="en-US" locale="en_US">
  {
    posts.length > 0 ? (
      <RecentPosts posts={posts} language="en" />
    ) : (
      <EmptyState
        title="No posts yet"
        description="This notebook is still being assembled. The first notes will appear here in chronological order."
      />
    )
  }
</BaseLayout>
