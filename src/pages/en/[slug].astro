---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InPageNav from '../../components/InPageNav.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { pagePath, SITE, toggleLanguagePath } from '../../lib/routes';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.language === 'en');

  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const path = pagePath(page.data.slug, 'en');
const alternates = page.data.kind === 'about'
  ? [{ hreflang: 'pt-BR' as const, path: toggleLanguagePath(path) }]
  : [];
---

<BaseLayout title={`${page.data.title} | ${SITE.name}`} description={page.data.summary ?? SITE.description} path={path} lang="en-US" locale="en_US" alternates={alternates} languageHref={alternates[0]?.path}>
  <div class="article-grid">
    <aside class="rail sticky-rail">
      <InPageNav headings={headings} title="in this page" />
    </aside>

    <article class="reading-flow surface article-shell prose" id="topo">
      <header class="article-head">
        <h1>{page.data.title}</h1>
        {page.data.summary && <p class="lede">{page.data.summary}</p>}
      </header>
      <Content />
      {page.data.kind === 'about' && <GiscusComments translationKey="about" language="en" />}
    </article>
  </div>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .rail {
    min-width: 0;
  }

  .article-shell {
    padding: 1.25rem;
  }

  .article-head {
    display: grid;
    gap: 0.8rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }

  @media (max-width: 920px) {
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
