---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/routes';

const pathname = Astro.url.pathname;
const actualLanguage = pathname.startsWith('/en') ? 'en' : 'pt';
---


<BaseLayout
  title={`${actualLanguage === 'pt' ? 'Não encontrado' : 'Not Found'} | ${SITE.name}`}
  description={
    actualLanguage === 'pt'
      ? 'Rota técnica de erro para a build estática do blog.'
      : 'Technical error route for the static blog build.'
  }
  path="/404/"
  noindex={true}
>
  <section class="surface reading-flow not-found">
    {actualLanguage === 'pt' ? (
      <>
        <span class="eyebrow">Erro de rota</span>
        <h1>Página não encontrada</h1>
        <p class="lede">
          Use a rota principal em português para continuar navegando.
        </p>
        <a class="button-link primary" href="/pt/">
          Ir para /pt/
        </a>
      </>
    ) : (
      <>
        <span class="eyebrow">Route error</span>
        <h1>Page not found</h1>
        <p class="lede">
          Use the main English route to continue browsing.
        </p>
        <a class="button-link primary" href="/en/">
          Go to /en/
        </a>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
  }

  h1,
  p {
    margin: 0;
  }
</style>
