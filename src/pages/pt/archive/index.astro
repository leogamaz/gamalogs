---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../lib/content';
import { archivePath, postPath, SITE } from '../../../lib/routes';

const posts = await getPublishedPosts();
type DayPosts = Record<string, CollectionEntry<'posts'>[]>;
type MonthBuckets = Record<string, DayPosts>;
type ArchiveBuckets = Record<string, MonthBuckets>;

const grouped = Object.entries(
  posts.reduce<ArchiveBuckets>((accumulator, post) => {
    const date = post.data.publishDate;
    const year = String(date.getFullYear());
    const month = date.toLocaleString('pt-BR', { month: 'long' });
    const day = date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });

    accumulator[year] ??= {};
    accumulator[year][month] ??= {};
    accumulator[year][month][day] ??= [];
    accumulator[year][month][day].push(post);

    return accumulator;
  }, {})
).sort((left, right) => Number(right[0]) - Number(left[0]));
---

<BaseLayout
  title={`Arquivo | ${SITE.name}`}
  description="Navegue pelas publicacoes em ordem cronologica, com agrupamento por ano, mes e dia."
  path={archivePath()}
>
  <section class="surface archive reading-flow archive-shell">
    

    <div class="timeline">
      {grouped.map(([year, months]) => (
        <section>
          <h2>{year}</h2>
          {Object.entries(months).map(([month, days]) => (
            <div class="month-block">
              <h3>{month}</h3>
              {Object.entries(days).map(([day, dayPosts]) => (
                <div class="day-block">
                  <p>{day}</p>
                  <ul>
                    {dayPosts.map((post) => (
                      <li><a href={postPath(post.slug)}>{post.data.title}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .archive-shell {
    padding: 1.25rem;
  }

  .archive-head {
    display: grid;
    gap: 0.7rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .timeline {
    display: grid;
    gap: 1.6rem;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
    margin-bottom: 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.05em;
  }

  h2 {
    color: var(--accent);
    margin-bottom: 0.55rem;
  }

  h3 {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 0.45rem;
  }

  .month-block {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.95rem;
  }

  .day-block {
    padding-left: 0.9rem;
    border-left: 1px solid rgba(124, 255, 114, 0.18);
    color: var(--text);
  }

  ul {
    margin: 0;
    padding-left: 1rem;
    color: var(--muted);
  }

  @media (max-width: 399px) {
    .archive-shell {
      padding: 0.95rem 0.8rem;
    }

    .archive-head {
      gap: 0.55rem;
      padding-bottom: 0.85rem;
      margin-bottom: 0.95rem;
    }

    .timeline {
      gap: 1.15rem;
    }

    h1 {
      font-size: clamp(1.65rem, 12vw, 2.25rem);
    }

    h2 {
      margin-bottom: 0.4rem;
      font-size: 1.18rem;
    }

    h3 {
      margin-bottom: 0.32rem;
      font-size: 0.86rem;
    }

    .month-block {
      gap: 0.7rem;
      margin-top: 0.7rem;
    }

    .day-block {
      padding-left: 0.65rem;
    }

    ul {
      padding-left: 0.85rem;
    }
  }
</style>
