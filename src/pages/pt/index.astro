---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import HomeHero from '../../components/HomeHero.astro';
import RecentPosts from '../../components/RecentPosts.astro';
import { getPublishedPosts, getTagMap } from '../../lib/content';
import { SITE } from '../../lib/routes';

const posts = await getPublishedPosts();
const tagMap = await getTagMap();
const filters = [...tagMap.values()]
  .sort((left, right) => right.posts.length - left.posts.length || left.name.localeCompare(right.name))
  .slice(0, 8)
  .map((tag) => ({
    label: tag.name.toLowerCase(),
    href: `/pt/tags/${tag.slug}/`,
    count: tag.posts.length,
  }));
---

<BaseLayout title={`${SITE.name} | Pagina inicial`} description={SITE.description} path="/pt/">
  <HomeHero count={posts.length} filters={filters} />

  {
    posts.length > 0 ? (
      <RecentPosts posts={posts} />
    ) : (
      <EmptyState
        title="Ainda sem publicacoes"
        description="O caderno esta sendo montado. As primeiras notas vao aparecer aqui em ordem cronologica."
      />
    )
  }
</BaseLayout>
