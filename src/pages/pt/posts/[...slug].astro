---
import { getCollection, render } from 'astro:content';
import { getPostTranslationPath } from '../../../lib/content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { getPostPath, getPostRouteSlug } from '../../../lib/routes';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.language === 'pt' && !data.draft);

  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: getPostRouteSlug(post) },
      props: {
        post,
        languageHref: await getPostTranslationPath(post, 'en'),
      },
    }))
  );
}

const { post, languageHref } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.summary}
  path={getPostPath(post)}
  publishDate={post.data.publishDate}
  tags={post.data.tags}
  headings={headings}
  language="pt"
  languageHref={languageHref}
>
  <Content />
</PostLayout>
