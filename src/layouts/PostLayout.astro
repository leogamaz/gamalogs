---
import BaseLayout from './BaseLayout.astro';
import type { SeoAlternate } from '../components/SeoHead.astro';
import InPageNav from '../components/InPageNav.astro';
import { homePath, slugifyTag, tagPath } from '../lib/routes';
import type { Language } from '../lib/content';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  publishDate: Date;
  tags?: string[];
  headings?: HeadingItem[];
  language?: Language;
  languageHref?: string;
}

const { title, description, path, publishDate, tags = [], headings = [], language = 'pt', languageHref } = Astro.props;
const locale = language === 'en' ? 'en_US' : 'pt_BR';
const htmlLang = language === 'en' ? 'en-US' : 'pt-BR';
const alternateLanguage = language === 'en' ? 'pt-BR' : 'en-US';
const alternateHomePath = homePath(language === 'en' ? 'pt' : 'en');
const alternates: SeoAlternate[] = languageHref && languageHref !== alternateHomePath
  ? [{ hreflang: alternateLanguage, path: languageHref }]
  : [];
---

<BaseLayout
  title={`${title} | Gama Logs`}
  description={description}
  path={path}
  type="article"
  publishedTime={publishDate.toISOString()}
  lang={htmlLang}
  locale={locale}
  alternates={alternates}
  languageHref={languageHref}
>
  <div class="article-grid">
    <aside class="rail sticky-rail">
      <InPageNav headings={headings} title={language === 'en' ? 'in this page' : 'nesta página'} />
    </aside>

    <article class="reading-flow surface article-shell" id="topo">
      <header class="article-head">
        <div class="topline">
          <span class="eyebrow">post</span>
          <time datetime={publishDate.toISOString()}>{publishDate.toISOString().slice(0, 10)}</time>
        </div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="meta-row">
          <span>{tags.length} tags</span>
        </div>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label={language === 'en' ? 'Post tags' : 'Etiquetas da publicacao'}>
            {tags.map((tag) => (
              <li><a class="tag-pill" href={tagPath(slugifyTag(tag), language)}>{tag}</a></li>
            ))}
          </ul>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .rail {
    min-width: 0;
  }

  .article-shell {
    width: 100%;
    padding: clamp(1.25rem, 3vw, 1.8rem);
  }

  .article-head {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .topline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.86rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  @media (max-width: 920px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .rail {
      height: 0;
      margin: 0;
    }
  }

  @media (max-width: 720px) {
    h1 {
      font-size: clamp(1.55rem, 10.5vw, 2.35rem);
      line-height: 1;
    }

    .lede {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 399px) {
    .article-grid,
    .rail,
    .article-shell {
      min-width: 0;
      width: 100%;
      max-width: 100%;
    }

    .article-shell {
      margin: 0;
      padding: 0.95rem 0.8rem;
    }

    .article-head {
      gap: 0.65rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.9rem;
    }

    .topline {
      gap: 0.45rem;
      font-size: 0.76rem;
    }

    h1 {
      font-size: clamp(1.35rem, 10vw, 2rem);
      line-height: 1;
      letter-spacing: -0.05em;
    }
  }
</style>
