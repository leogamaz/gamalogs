---
import BaseLayout from './BaseLayout.astro';
import type { Language } from '../lib/content';

interface Props {
  title: string;
  description: string;
  path: string;
  publishDate: Date;
  language?: Language;
}

const { title, description, path, publishDate, language = 'pt' } = Astro.props;
const locale = language === 'en' ? 'en_US' : 'pt_BR';
const htmlLang = language === 'en' ? 'en-US' : 'pt-BR';
---

<BaseLayout
  title={`${title} | Gama Logs`}
  description={description}
  path={path}
  type="article"
  publishedTime={publishDate.toISOString()}
  lang={htmlLang}
  locale={locale}
  showSiteNav={false}
  fullBleed
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&family=Geist+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <slot />
</BaseLayout>
