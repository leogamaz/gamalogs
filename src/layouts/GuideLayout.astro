---
import BaseLayout from './BaseLayout.astro';
import type { SeoAlternate } from '../components/SeoHead.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import GiscusComments from '../components/GiscusComments.astro';
import type { Language } from '../lib/content';
import { homePath } from '../lib/routes';

interface Props {
  title: string;
  description: string;
  path: string;
  publishDate: Date;
  translationKey: string;
  language?: Language;
  languageHref?: string;
}

const { title, description, path, publishDate, translationKey, language = 'pt', languageHref } = Astro.props;
const locale = language === 'en' ? 'en_US' : 'pt_BR';
const htmlLang = language === 'en' ? 'en-US' : 'pt-BR';
const alternateLanguage = language === 'en' ? 'pt-BR' : 'en-US';
const alternateHomePath = homePath(language === 'en' ? 'pt' : 'en');
const alternates: SeoAlternate[] = languageHref && languageHref !== alternateHomePath
  ? [{ hreflang: alternateLanguage, path: languageHref }]
  : [];
---

<BaseLayout
  title={`${title} | Gama Logs`}
  description={description}
  path={path}
  type="article"
  publishedTime={publishDate.toISOString()}
  lang={htmlLang}
  locale={locale}
  alternates={alternates}
  showSiteNav={false}
  fullBleed
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400&family=Geist+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <LanguageSwitch href={languageHref} currentLanguage={language} variant="floating" />
  <slot />
  <GiscusComments translationKey={translationKey} language={language} />
</BaseLayout>
