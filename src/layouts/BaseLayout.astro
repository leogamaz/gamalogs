---
import SeoHead from '../components/SeoHead.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

type Hreflang = 'pt-BR' | 'en-US';

interface Alternate {
  hreflang: Hreflang;
  path: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  locale?: string;
  alternates?: Alternate[];
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  showSiteNav?: boolean;
  fullBleed?: boolean;
}

const {
  title,
  description,
  path,
  lang = 'pt-BR',
  locale = 'pt_BR',
  alternates = [],
  image,
  type,
  publishedTime,
  noindex = false,
  showSiteNav = true,
  fullBleed = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <SeoHead
        title={title}
        description={description}
        path={path}
        locale={locale}
        alternates={alternates}
        image={image}
        type={type}
        publishedTime={publishedTime}
        noindex={noindex}
      />
      <slot name="head" />
    </head>
  <body>
    <main class:list={["page-stack", { "page-stack-full": fullBleed }]}>
      {showSiteNav && <SiteNav />}
      <slot />
    </main>
  </body>
</html>

<style>
  .page-stack-full {
    width: 100%;
    max-width: none;
    padding: 0;
  }
</style>
