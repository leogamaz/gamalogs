---
import { archivePath, guidesPath, homePath, pagePath } from '../lib/routes';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  languageHref?: string;
}

const pathname = Astro.url.pathname;
const { languageHref } = Astro.props as Props;
type IconName = 'archive' | 'guides' | 'github' | 'rss' | 'about';
const language = pathname.startsWith('/en') ? 'en' : 'pt';
const aboutSlug = language === 'en' ? 'about' : 'sobre';
const ui = language === 'en'
  ? {
      navLabel: 'Main navigation',
      openLabel: 'Open in this page',
      inPageLabel: 'in this page',
      open: 'Open',
      close: 'Close',
      searchLabel: 'Search Gama Logs',
      searchPlaceholder: 'Enter a topic or term',
    }
  : {
      navLabel: 'Navegacao principal',
      openLabel: 'Abrir nesta página',
      inPageLabel: 'nesta página',
      open: 'Abrir',
      close: 'Fechar',
      searchLabel: 'Pesquisar no Gama Logs',
      searchPlaceholder: 'Digite um assunto ou termo',
    };

const links: Array<{ href: string; label: string; icon: IconName; external?: boolean }> = [
  { href: archivePath(language), label: 'archive', icon: 'archive' },
  { href: guidesPath(language), label: 'guides', icon: 'guides' },
  { href: 'https://github.com/leogamaz', label: 'GitHub', icon: 'github', external: true },
  { href: '/rss.xml', label: 'rss', icon: 'rss' },
  { href: pagePath(aboutSlug, language), label: 'about', icon: 'about' },
];

function isActive(href: string) {
  if (href.endsWith('/guides/')) return pathname.startsWith(`/${language}/guides`);
  if (href.endsWith('/archive/')) return pathname.startsWith(`/${language}/archive`);
  if (href.endsWith('/about/') || href.endsWith('/sobre/')) return pathname.startsWith(`/${language}/${aboutSlug}`);
  return pathname === href;
}

const icons: Record<IconName, string> = {
  archive: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive-icon lucide-archive"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
  `,
  guides: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-icon lucide-book-open"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
  `,
  github: `
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.63-5.373-12-12-12"></path></svg>
  `,
  rss: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss-icon lucide-rss"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
  `,
  about: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
  `,
} as const;

const inPageIcons = {
  menu: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-icon lucide-grip"><circle cx="12" cy="5" r="1"/><circle cx="19" cy="5" r="1"/><circle cx="5" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/><circle cx="12" cy="19" r="1"/><circle cx="19" cy="19" r="1"/><circle cx="5" cy="19" r="1"/></svg>
  `,
  index: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-filter-icon lucide-list-filter"><path d="M2 5h20"/><path d="M6 12h12"/><path d="M9 19h6"/></svg>
  `,
  close: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  `,
  search: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
  `,
} as const;
---

<nav class="site-nav surface" aria-label={ui.navLabel}>
  <div class="site-nav-inner">
    <a class="brand" href={homePath(language)}>
      <span class="prompt">~/</span>
      <strong>gamalogs</strong>
      <span class="caret" aria-hidden="true">▍</span>
    </a>

    <div class="links">
      <div class="mobile-nav-menu" id="site-nav-menu" data-site-nav-menu>
        <form class="site-search" action="https://www.google.com/search" method="get" target="_blank" data-site-search>
          <label for="site-search-input" class="sr-only">{ui.searchLabel}</label>
          <div class="site-search-field">
            <span class="site-search-icon" aria-hidden="true" set:html={inPageIcons.search} />
            <input
              id="site-search-input"
              name="q"
              type="search"
              aria-label={ui.searchLabel}
              placeholder={ui.searchPlaceholder}
              autocomplete="off"
              required
            />
          </div>
        </form>

        <div class="primary-links">
      {links.map((link) => (
        <a
          class:list={[isActive(link.href) && 'active']}
          href={link.href}
          aria-label={link.external ? `${link.label} (${language === 'en' ? 'external link' : 'link externo'})` : link.label}
          aria-current={isActive(link.href) ? 'page' : undefined}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          <span class="sr-only">{link.external ? `${link.label} (${language === 'en' ? 'external link' : 'link externo'})` : link.label}</span>
          <svg
            class="nav-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons[link.icon]}
          />
        </a>
      ))}
        </div>
      </div>

      <LanguageSwitch href={languageHref} currentLanguage={language} variant="header" />

      <button
        class="site-menu-toggle"
        type="button"
        aria-label={language === 'en' ? 'Open main menu' : 'Abrir menu principal'}
        aria-expanded="false"
        aria-controls="site-nav-menu"
        data-site-nav-toggle
        data-open-label={language === 'en' ? 'Open main menu' : 'Abrir menu principal'}
        data-close-label={language === 'en' ? 'Close main menu' : 'Fechar menu principal'}
      >
        <span class="sr-only">{language === 'en' ? 'Main menu' : 'Menu principal'}</span>
        <span class="site-menu-icon site-menu-icon-open" aria-hidden="true" set:html={inPageIcons.menu} />
        <span class="site-menu-icon site-menu-icon-close" aria-hidden="true" set:html={inPageIcons.close} />
      </button>

      <button
        class="inpage-toggle"
        type="button"
        aria-label={ui.openLabel}
        aria-expanded="false"
        aria-controls="in-page-nav-panel"
        data-in-page-nav-toggle
        data-in-page-nav-button
        data-in-page-open-text={ui.open}
        data-in-page-close-text={ui.close}
        data-in-page-target-text={ui.inPageLabel}
      >
        <span class="sr-only">{ui.inPageLabel}</span>
        <span class="inpage-icon inpage-icon-index" aria-hidden="true" set:html={inPageIcons.index} />
        <span class="inpage-icon inpage-icon-close" aria-hidden="true" set:html={inPageIcons.close} />
      </button>
    </div>
  </div>
</nav>

<script src="../scripts/in-page-nav-controller.ts"></script>
<script src="../scripts/site-nav-controller.ts"></script>

<style>
  .site-nav {
    width: 100dvw;
    margin-inline: calc(50% - 50dvw);
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 20;
    margin-top: 0;
    margin-bottom: 0;
    background: rgba(7, 10, 12, 0.466);
    backdrop-filter: blur(16px);
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    border-bottom: 1px solid var(--line);
  }

  .site-nav-inner {
    width: min(calc(100% - 2rem), var(--content));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--text);
    font-size: 1.02rem;
  }

  .prompt,
  .caret {
    color: var(--accent);
  }

  .brand strong {
    letter-spacing: 0.02em;
  }

  .caret {
    animation: blink 1.1s steps(1, end) infinite;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .mobile-nav-menu {
    display: contents;
  }

  .site-search {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: clamp(12rem, 22vw, 18rem);
  }

  .site-search-field {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    flex: 1;
  }

  .site-search-icon {
    position: absolute;
    left: 0.7rem;
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--muted);
    pointer-events: none;
  }

  .site-search-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .site-search input {
    width: 100%;
    min-width: 0;
    height: 2.6rem;
    padding: 0 0.65rem 0 2.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    outline: none;
    color: var(--text);
    background: rgba(255, 255, 255, 0.03);
    font: inherit;
    font-size: 0.78rem;
  }

  .site-search input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .site-search input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(124, 255, 114, 0.14);
  }

  .primary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .primary-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.15rem;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .nav-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .inpage-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.15rem;
    color: var(--muted);
    border: 1px solid transparent;
    background: transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
    cursor: pointer;
    padding: 0;
  }

  .site-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.15rem;
    color: var(--muted);
    border: 1px solid transparent;
    background: transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
    cursor: pointer;
    padding: 0;
  }

  .site-menu-icon {
    display: none;
    width: 1.15rem;
    height: 1.15rem;
  }

  .site-menu-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .inpage-icon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .inpage-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .primary-links a.active,
  .primary-links a:hover,
  .primary-links a:focus-visible {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.2);
    background: rgba(124, 255, 114, 0.05);
  }

  .inpage-toggle:hover,
  .inpage-toggle:focus-visible,
  .site-menu-toggle:hover,
  .site-menu-toggle:focus-visible {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.2);
    background: rgba(124, 255, 114, 0.05);
  }

  .site-menu-toggle[aria-expanded='false'] .site-menu-icon-open,
  .site-menu-toggle[aria-expanded='true'] .site-menu-icon-close {
    display: inline-flex;
  }

  .site-menu-toggle[aria-expanded='true'] {
    color: var(--accent);
  }

  .inpage-toggle[aria-expanded='false'] .inpage-icon-index,
  .inpage-toggle[aria-expanded='true'] .inpage-icon-close {
    display: inline-flex;
  }

  .inpage-toggle[aria-expanded='true'] {
    color: var(--accent);
  }

  @media (max-width: 920px) {
    .site-nav {
      position: sticky;
      width: 100dvw;
      margin-inline: calc(50% - 50dvw);
      z-index: 30;
    }

    .site-nav-inner {
      width: 100%;
      flex-wrap: wrap;
      padding: 0.9rem 1.1rem;
    }

    .links {
      flex: 1;
      flex-wrap: wrap;
    }

    .site-search {
      flex: 0 1 100%;
      width: 100%;
      max-width: 24rem;
      order: 2;
    }

    .primary-links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .inpage-toggle {
      display: inline-flex;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (min-width: 600px) and (max-width: 920px) {
    .site-nav-inner {
      flex-wrap: nowrap;
    }

    .links {
      position: relative;
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) auto auto auto;
      align-items: center;
      flex: 1 1 auto;
      min-width: 0;
    }

    .site-menu-toggle {
      display: inline-flex;
      grid-column: 3;
      grid-row: 1;
    }

    :global(.language-switch-header) {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      min-width: max-content;
    }

    .primary-links {
      display: none;
      position: absolute;
      top: calc(100% + 0.65rem);
      right: 0;
      z-index: 2;
      min-width: 13rem;
      padding: 0.45rem;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.45rem;
      border: 1px solid var(--line);
      border-radius: 0.15rem;
      background: rgba(10, 14, 18, 0.96);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    .primary-links a {
      width: 100%;
      justify-content: flex-start;
      gap: 0.7rem;
      padding-inline: 0.75rem;
    }

    .primary-links a .sr-only {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .mobile-nav-menu[data-open='true'] .primary-links {
      display: flex;
    }

    .inpage-toggle {
      grid-column: 4;
      grid-row: 1;
    }

    .site-search {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      max-width: none;
      min-width: 0;
      margin-top: 0;
      justify-self: stretch;
    }
  }

  @media (max-width: 599px) {
    .links {
      position: relative;
    }

    .mobile-nav-menu {
      display: none;
      position: absolute;
      top: calc(100% + 0.65rem);
      right: 0;
      z-index: 2;
      min-width: 13rem;
      padding: 0.45rem;
      flex-direction: column;
      gap: 0.45rem;
      border: 1px solid var(--line);
      border-radius: 0.15rem;
      background: rgba(10, 14, 18, 0.96);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px);
    }

    .mobile-nav-menu[data-open='true'] {
      display: flex;
    }

    .site-search {
      display: flex;
      width: 100%;
      order: 0;
    }

    .site-search input {
      height: 2.5rem;
    }

    .primary-links {
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .primary-links a {
      width: 100%;
      justify-content: flex-start;
      gap: 0.7rem;
      padding-inline: 0.75rem;
    }

    .primary-links a .sr-only {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .site-menu-toggle {
      display: inline-flex;
    }

    .inpage-toggle {
      order: 1;
    }

    .site-menu-toggle {
      order: 2;
    }
  }

  @media (min-width: 400px) and (max-width: 599px) {
    .links {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 2.5rem 2.5rem;
      align-items: center;
      min-width: 0;
      gap: 0.4rem;
    }

    .site-menu-toggle,
    .inpage-toggle {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (max-width: 399px) {
    .site-nav-inner {
      gap: 0.45rem;
      padding: 0.65rem 0.55rem;
    }

    .brand {
      gap: 0.2rem;
      min-width: 0;
      font-size: 0.88rem;
    }

    .brand strong {
      max-width: 5.2rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .links {
      flex: none;
      gap: 0.2rem;
    }

    .primary-links {
      min-width: 11rem;
    }

    .primary-links a,
    .inpage-toggle {
      width: 7rem;
      height: 2.25rem;
      border-radius: 0.15rem;
    }

    .site-menu-toggle {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.62rem;
    }

    .nav-icon,
    .inpage-icon,
    .site-menu-icon {
      width: 1rem;
      height: 1rem;
    }
  }

  @media (min-width: 250px) and (max-width: 358px) {
    .site-nav-inner {
      flex-wrap: nowrap;
      gap: 0.3rem;
    }

    .brand {
      flex: 0 1 auto;
      font-size: 0.78rem;
    }

    .brand strong {
      max-width: 4.5rem;
    }

    .links {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 2.25rem 2.25rem;
      align-items: center;
      flex: 1 1 auto;
      min-width: 0;
      gap: 0.2rem;
    }

    :global(.language-switch-header) {
      min-width: 0;
      padding: 0;
    }

    :global(.language-switch-header .switch-copy span) {
      font-size: 0.44rem;
      letter-spacing: 0.06em;
    }

    :global(.language-switch-header .switch-copy strong) {
      overflow: hidden;
      font-size: 0.62rem;
      letter-spacing: 0;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .inpage-toggle,
    .site-menu-toggle {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }
</style>
