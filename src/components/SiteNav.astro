---
import { archivePath, pagePath, ptPath } from '../lib/routes';

const pathname = Astro.url.pathname;
const links = [
  { href: archivePath(), label: 'archive' },
  { href: '/pt/tags/', label: 'tags' },
  { href: '/rss.xml', label: 'rss' },
  { href: pagePath('sobre'), label: 'about' },
];

function isActive(href: string) {
  if (href === '/pt/tags/') return pathname.startsWith('/pt/tags');
  return pathname === href;
}
---

<nav class="site-nav surface" aria-label="Navegacao principal">
  <div class="site-nav-inner">
    <a class="brand" href={ptPath('/')}>
      <span class="prompt">~/</span>
      <strong>gamalogs</strong>
      <span class="caret" aria-hidden="true">▍</span>
    </a>

    <div class="links">
      {links.map((link) => (
        <a class:list={[isActive(link.href) && 'active']} href={link.href}>
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .site-nav {
    width: 100dvw;
    margin-inline: calc(50% - 50dvw);
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 20;
    margin-top: 0;
    margin-bottom: 0;
    background: rgba(7, 10, 12, 0.88);
    backdrop-filter: blur(16px);
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    border-bottom: 1px solid var(--line);
  }

  .site-nav-inner {
    width: min(calc(100% - 2rem), var(--content));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--text);
    font-size: 1.02rem;
  }

  .prompt,
  .caret {
    color: var(--accent);
  }

  .brand strong {
    letter-spacing: 0.02em;
  }

  .caret {
    animation: blink 1.1s steps(1, end) infinite;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .links a {
    padding: 0.42rem 0.72rem;
    border-radius: 0.7rem;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .links a.active,
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.2);
    background: rgba(124, 255, 114, 0.05);
  }

  @media (max-width: 720px) {
    .site-nav {
      position: static;
      width: 100%;
      margin-inline: 0;
    }

    .site-nav-inner {
      width: 100%;
      padding: 0.9rem 1.1rem;
    }
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }
</style>
