---
import { archivePath, guidesPath, homePath, pagePath } from '../lib/routes';

const pathname = Astro.url.pathname;
type IconName = 'archive' | 'guides' | 'tags' | 'rss' | 'about';
const language = pathname.startsWith('/en') ? 'en' : 'pt';
const aboutSlug = language === 'en' ? 'about' : 'sobre';
const ui = language === 'en'
  ? {
      navLabel: 'Main navigation',
      openLabel: 'Open in this page',
      inPageLabel: 'in this page',
      open: 'Open',
      close: 'Close',
    }
  : {
      navLabel: 'Navegacao principal',
      openLabel: 'Abrir nesta página',
      inPageLabel: 'nesta página',
      open: 'Abrir',
      close: 'Fechar',
    };

const links: Array<{ href: string; label: string; icon: IconName }> = [
  { href: archivePath(language), label: 'archive', icon: 'archive' },
  { href: guidesPath(language), label: 'guides', icon: 'guides' },
  { href: `/${language}/tags/`, label: 'tags', icon: 'tags' },
  { href: '/rss.xml', label: 'rss', icon: 'rss' },
  { href: pagePath(aboutSlug, language), label: 'about', icon: 'about' },
];

function isActive(href: string) {
  if (href.endsWith('/tags/')) return pathname.startsWith(`/${language}/tags`);
  if (href.endsWith('/guides/')) return pathname.startsWith(`/${language}/guides`);
  if (href.endsWith('/archive/')) return pathname.startsWith(`/${language}/archive`);
  if (href.endsWith('/about/') || href.endsWith('/sobre/')) return pathname.startsWith(`/${language}/${aboutSlug}`);
  return pathname === href;
}

const icons: Record<IconName, string> = {
  archive: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive-icon lucide-archive"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
  `,
  guides: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-icon lucide-book-open"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
  `,
  tags: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag-icon lucide-tag"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
  `,
  rss: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss-icon lucide-rss"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
  `,
  about: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info-icon lucide-info"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
  `,
} as const;

const inPageIcons = {
  menu: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu-icon lucide-menu"><path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/></svg>
  `,
  close: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  `,
} as const;
---

<nav class="site-nav surface" aria-label={ui.navLabel}>
  <div class="site-nav-inner">
    <a class="brand" href={homePath(language)}>
      <span class="prompt">~/</span>
      <strong>gamalogs</strong>
      <span class="caret" aria-hidden="true">▍</span>
    </a>

    <div class="links">
      {links.map((link) => (
        <a
          class:list={[isActive(link.href) && 'active']}
          href={link.href}
          aria-label={link.label}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          <span class="sr-only">{link.label}</span>
          <svg
            class="nav-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons[link.icon]}
          />
        </a>
      ))}

      <button
        class="inpage-toggle"
        type="button"
        aria-label={ui.openLabel}
        aria-expanded="false"
        aria-controls="in-page-nav-panel"
        data-in-page-nav-toggle
        data-in-page-nav-button
        data-in-page-open-text={ui.open}
        data-in-page-close-text={ui.close}
        data-in-page-target-text={ui.inPageLabel}
      >
        <span class="sr-only">{ui.inPageLabel}</span>
        <span class="inpage-icon inpage-icon-menu" aria-hidden="true" set:html={inPageIcons.menu} />
        <span class="inpage-icon inpage-icon-close" aria-hidden="true" set:html={inPageIcons.close} />
      </button>
    </div>
  </div>
</nav>

<script src="../scripts/in-page-nav-controller.ts"></script>

<style>
  .site-nav {
    width: 100dvw;
    margin-inline: calc(50% - 50dvw);
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 20;
    margin-top: 0;
    margin-bottom: 0;
    background: rgba(7, 10, 12, 0.466);
    backdrop-filter: blur(16px);
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    border-bottom: 1px solid var(--line);
  }

  .site-nav-inner {
    width: min(calc(100% - 2rem), var(--content));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--text);
    font-size: 1.02rem;
  }

  .prompt,
  .caret {
    color: var(--accent);
  }

  .brand strong {
    letter-spacing: 0.02em;
  }

  .caret {
    animation: blink 1.1s steps(1, end) infinite;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .nav-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .inpage-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.75rem;
    color: var(--muted);
    border: 1px solid transparent;
    background: transparent;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
    cursor: pointer;
    padding: 0;
  }

  .inpage-icon {
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .inpage-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .links a.active,
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.2);
    background: rgba(124, 255, 114, 0.05);
  }

  .inpage-toggle:hover,
  .inpage-toggle:focus-visible {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.2);
    background: rgba(124, 255, 114, 0.05);
  }

  .inpage-toggle[aria-expanded='false'] .inpage-icon-menu,
  .inpage-toggle[aria-expanded='true'] .inpage-icon-close {
    display: inline-flex;
  }

  .inpage-toggle[aria-expanded='true'] {
    color: var(--accent);
  }

  @media (max-width: 920px) {
    .site-nav {
      position: sticky;
      width: 100dvw;
      margin-inline: calc(50% - 50dvw);
      z-index: 30;
    }

    .site-nav-inner {
      width: 100%;
      padding: 0.9rem 1.1rem;
    }

    .links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .inpage-toggle {
      display: inline-flex;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (max-width: 399px) {
    .site-nav-inner {
      gap: 0.45rem;
      padding: 0.65rem 0.55rem;
    }

    .brand {
      gap: 0.2rem;
      min-width: 0;
      font-size: 0.88rem;
    }

    .brand strong {
      max-width: 5.2rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .links {
      flex: none;
      gap: 0.2rem;
    }

    .links a,
    .inpage-toggle {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.62rem;
    }

    .nav-icon,
    .inpage-icon {
      width: 1rem;
      height: 1rem;
    }
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }
</style>
