---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="hero surface">
  <div class="hero-copy">
    <span class="eyebrow">Edicao estatica</span>
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="actions">
      <a class="button-link primary" href="/pt/archive/">Ver arquivo</a>
      <a class="button-link secondary" href="/pt/sobre/">Ler manifesto</a>
    </div>
  </div>

  <div class="hero-note" aria-hidden="true">
    <div>
      <strong>Leitura antes do brilho</strong>
      <p>Pouco ruído, muito contraste, rotas estaveis e uma pagina inicial que convida a continuar.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(16rem, 0.9fr);
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  p {
    margin: 0;
    font-size: 1.08rem;
    color: var(--muted);
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.5rem;
  }

  .hero-note {
    display: grid;
    align-items: end;
    padding: 1rem;
    border-radius: calc(var(--radius) - 8px);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0.78)),
      radial-gradient(circle at top right, rgba(239, 179, 111, 0.35), transparent 55%);
    border: 1px solid rgba(71, 40, 27, 0.1);
  }

  .hero-note strong {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
