---
interface FilterLink {
  label: string;
  href: string;
  count: number;
}

interface Props {
  count?: number;
  filters?: FilterLink[];
}

const { count = 0, filters = [] } = Astro.props;
---

<section class="filter-bar surface" aria-label="Filtros da pagina inicial">
  <span class="label">filter:</span>

  <div class="chips">
    <a class="chip active" href="/pt/">all</a>
    {filters.map((filter) => (
      <a class="chip" href={filter.href}>{filter.label}</a>
    ))}
  </div>

  <p class="count">{String(count).padStart(2, '0')} posts</p>
</section>

<style>
  .filter-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0.95rem;
    margin-bottom: 0.85rem;
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    box-shadow: none;
    background: rgba(8, 11, 13, 0.92);
    position: sticky;
    top: 5rem;
    z-index: 15;
  }

  .filter-bar::before,
  .filter-bar::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
  }

  .filter-bar::before {
    top: 0;
  }

  .filter-bar::after {
    bottom: 0;
  }

  .label,
  .count {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1;
  }

  .label {
    color: var(--muted);
    text-transform: lowercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.72rem;
    border: 1px solid rgba(58, 79, 88, 0.95);
    border-radius: 0.32rem;
    color: var(--muted);
    text-decoration: none;
    text-transform: lowercase;
    font-size: 0.82rem;
    line-height: 1;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }

  .chip:hover,
  .chip:focus-visible,
  .chip.active {
    color: var(--accent);
    border-color: rgba(124, 255, 114, 0.75);
    background: rgba(124, 255, 114, 0.04);
  }

  .count {
    text-align: right;
    min-width: max-content;
  }

  @media (max-width: 800px) {
    .filter-bar {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      padding: 0.65rem 0.8rem;
      position: static;
      top: auto;
    }

    .count {
      text-align: left;
    }
  }
</style>
