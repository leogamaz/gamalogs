---
interface Props {
  href: string;
  title: string;
  summary: string;
  publishDate: Date;
  tags?: string[];
}

const { href, title, summary, publishDate, tags = [] } = Astro.props;
---

<article class="guide-card">
  <a class="guide-link" href={href}>
    <span class="guide-kicker">guia</span>
    <h2>{title}</h2>
    <p>{summary}</p>
    <footer>
      <time datetime={publishDate.toISOString()}>{publishDate.toISOString().slice(0, 10)}</time>
      {tags.length > 0 && <span>{tags.length} tags</span>}
    </footer>
  </a>
</article>

<style>
  .guide-card {
    border-top: 1px solid var(--line);
  }

  .guide-link {
    display: grid;
    gap: 0.7rem;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .guide-link:hover,
  .guide-link:focus-visible {
    transform: translateX(0.18rem);
  }

  .guide-kicker {
    width: max-content;
    padding: 0.28rem 0.55rem;
    border: 1px solid rgba(77, 225, 255, 0.2);
    border-radius: 0.35rem;
    color: var(--accent-soft);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgba(77, 225, 255, 0.04);
  }

  h2,
  p,
  footer {
    margin: 0;
  }

  h2 {
    font-size: clamp(1.35rem, 3vw, 2.15rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  p {
    max-width: 42rem;
    color: var(--muted);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (max-width: 399px) {
    .guide-link {
      padding: 0.95rem 0;
    }

    .guide-link:hover,
    .guide-link:focus-visible {
      transform: none;
    }
  }
</style>
