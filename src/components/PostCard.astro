---
import { tagPath, slugifyTag } from "../lib/routes";
import type { Language } from "../lib/content";

interface Props {
  rank?: string;
  href: string;
  title: string;
  summary: string;
  publishDate: Date;
  tags?: string[];
  readingMinutes?: number;
  language?: Language;
}

const {
  href,
  title,
  summary,
  publishDate,
  tags = [],
  readingMinutes = 1,
  language = "pt",
} = Astro.props;
const locale = language === "en" ? "en-US" : "pt-BR";
const formattedDate = publishDate.toLocaleDateString(locale, {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<article class="post-card">
  <div class="card-content">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    <div class="foot">
      <span
        >{
          language === "en"
            ? `${readingMinutes} min read`
            : `${readingMinutes} min de leitura`
        }</span
      >
      {
        tags.length > 0 && (
          <ul
            class="post-tags"
            aria-label={
              language === "en" ? "Post tags" : "Etiquetas da publicação"
            }
          >
            {tags.map((tag, index) => (
              <li>
                {index > 0 && (
                  <span class="tag-separator" aria-hidden="true">
                    ·
                  </span>
                )}
                <a href={tagPath(slugifyTag(tag), language)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    height: 64px;
    max-height: 64px;
    padding: 0.42rem 1.8rem 0.36rem 2rem;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }
  .card-content {
    display: grid;
    grid-template-rows: 0.78rem 1.25rem 1rem;
    gap: 0.12rem;
    max-width: 52rem;
    min-width: 0;
  }
  .post-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    opacity: 0;
    background: var(--accent);
    box-shadow: 0 0 22px rgba(124, 255, 114, 0.24);
    transition: opacity 180ms ease;
  }
  .post-card:hover,
  .post-card:focus-within {
    border-top-color: rgba(124, 255, 114, 0.3);
    border-bottom-color: rgba(124, 255, 114, 0.22);
    background: linear-gradient(
      90deg,
      rgba(124, 255, 114, 0.07),
      rgba(124, 255, 114, 0.025) 72%,
      transparent
    );
  }
  .post-card:hover::before,
  .post-card:focus-within::before {
    opacity: 1;
  }
  time {
    color: var(--muted);
    font-size: 0.61rem;
    line-height: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0;
    font-size: clamp(0.95rem, 1.35vw, 1.18rem);
    line-height: 1.25rem;
    letter-spacing: -0.025em;
    font-weight: 500;
  }
  h3 a {
    text-decoration: none;
  }
  .summary {
    display: none;
  }
  .foot {
    display: block;
    margin: 0;
    color: var(--muted);
    font-size: 0.67rem;
    line-height: 1rem;
    letter-spacing: 0.02em;
  }
  .foot > span:first-child {
    display: none;
  }
  /* Direct-child specificity keeps the metadata list independent from generic ul rules. */
  .foot > ul.post-tags {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  .foot > ul.post-tags > li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .post-tags a {
    color: var(--accent);
    text-decoration-color: rgba(124, 255, 114, 0.45);
    text-underline-offset: 0.22em;
  }
  .tag-separator {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .post-card {
      padding: 0.42rem 1rem 0.36rem 1.25rem;
    }
  }
  @media (max-width: 399px) {
    .post-card {
      padding: 0.42rem 0.7rem 0.36rem 1rem;
    }
    time {
      font-size: 0.56rem;
    }
    h3 {
      font-size: 0.9rem;
    }
    .foot {
      font-size: 0.62rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card::before {
      transition: none;
    }
  }
</style>
