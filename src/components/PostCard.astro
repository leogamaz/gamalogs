---
import { postPath, tagPath, slugifyTag } from '../lib/routes';

interface Props {
  slug: string;
  title: string;
  summary: string;
  publishDate: Date;
  tags?: string[];
}

const { slug, title, summary, publishDate, tags = [] } = Astro.props;
---

<article class="card surface">
  <div class="topline">
    <time datetime={publishDate.toISOString()}>{publishDate.toLocaleDateString('pt-BR')}</time>
    {tags.length > 0 && <span>{tags.length} etiqueta(s)</span>}
  </div>
  <h3><a href={postPath(slug)}>{title}</a></h3>
  <p>{summary}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="Etiquetas da publicacao">
      {tags.map((tag) => (
        <li><a class="tag-pill" href={tagPath(slugifyTag(tag))}>{tag}</a></li>
      ))}
    </ul>
  )}
</article>

<style>
  .card {
    display: grid;
    gap: 0.85rem;
    padding: 1.3rem;
  }

  .topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: 1.45rem;
    line-height: 1.1;
  }

  p {
    color: var(--muted);
  }
</style>
