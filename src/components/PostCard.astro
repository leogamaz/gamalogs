---
import { postPath, tagPath, slugifyTag } from '../lib/routes';
import type { Language } from '../lib/content';

interface Props {
  rank?: string;
  slug: string;
  title: string;
  summary: string;
  publishDate: Date;
  tags?: string[];
  readingMinutes?: number;
  language?: Language;
}

const { rank = '#0000', slug, title, summary, publishDate, tags = [], readingMinutes = 1, language = 'pt' } = Astro.props;
const initials = (tags[0] ?? title).slice(0, 1).toUpperCase();
---

<article class="card">


  <div class="thumb" aria-hidden="true">
    <span>{initials}</span>
  </div>

  <div class="card-content">
    <h3><a href={postPath(slug, language)}>{title}</a></h3>
    
    <div class="foot">
      <span>{readingMinutes} min · read →</span>
      {tags.length > 0 && <span>{tags.length} tags</span>}
    </div>
    {tags.length > 0 && (
      <ul class="tag-list" aria-label={language === 'en' ? 'Post tags' : 'Etiquetas da publicacao'}>
        {tags.map((tag) => (
          <li><a class="tag-pill" href={tagPath(slugifyTag(tag), language)}>{tag}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .card-content {
    min-width: 0;
  }

  .card:hover {
    transform: translateX(0.18rem);
    border-top-color: rgba(124, 255, 114, 0.3);
  }

  .meta {
    display: grid;
    gap: 0.1rem;
    color: var(--muted);
    font-size: 0.82rem;
    padding-top: 0.35rem;
  }

  .rank {
    color: #8f86ff;
  }

  .thumb {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(124, 255, 114, 0.12);
    background:
      linear-gradient(180deg, rgba(20, 28, 33, 0.95), rgba(11, 15, 19, 0.95)),
      radial-gradient(circle at top, rgba(124, 255, 114, 0.18), transparent 58%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.015);
    color: var(--accent);
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
    font-weight: 400;
  }

  h3 a {
    text-decoration: none;
  }

  p {
    margin: 0.45rem 0 0;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .tag-list {
    margin-top: 0.7rem;
  }

  @media (max-width: 760px) {
    .card {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  @media (max-width: 399px) {
    .card {
      grid-template-columns: 2.55rem minmax(0, 1fr);
      gap: 0.65rem;
      padding: 0.9rem 0;
    }

    .card:hover {
      transform: none;
    }

    .thumb {
      width: 2.35rem;
      height: 2.35rem;
      font-size: 0.82rem;
    }

    h3 {
      font-size: 1rem;
      line-height: 1.22;
    }

    .foot {
      gap: 0.45rem 0.7rem;
      margin-top: 0.52rem;
      font-size: 0.74rem;
    }

    .tag-list {
      margin-top: 0.55rem;
    }
  }
</style>
