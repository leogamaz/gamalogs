---
import type { Language } from '../lib/content';

interface Props {
  translationKey: string;
  language: Language;
}

const { translationKey, language } = Astro.props;
---

<div class="giscus-comments" aria-label={language === 'en' ? 'Comments' : 'Comentários'}>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="leogamaz/gamalogs"
    data-repo-id="R_kgDOS07ZTA"
    data-category="Announcements"
    data-category-id="DIC_kwDOS07ZTM4DEHzP"
    data-mapping="specific"
    data-term={translationKey}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang={language}
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</div>

<style>
  .giscus-comments {
    margin-top: 2rem;
  }
</style>
