---
import type { CollectionEntry } from 'astro:content';
import InPageNav from './InPageNav.astro';
import PostCard from './PostCard.astro';
import type { Language } from '../lib/content';
import { getPostPath } from '../lib/routes';

interface Props {
  posts: CollectionEntry<'posts'>[];
  language?: Language;
}

const { posts = [], language = 'pt' } = Astro.props as Props;
const locale = language === 'en' ? 'en-US' : 'pt-BR';

type MonthBucket = {
  id: string;
  label: string;
  posts: CollectionEntry<'posts'>[];
};

const archiveMap = new Map<string, MonthBucket>();

for (const post of posts) {
  const date = post.data.publishDate;
  const year = String(date.getFullYear());
  const monthNumber = String(date.getMonth() + 1).padStart(2, '0');
  const monthLabel = date.toLocaleString(locale, { month: 'long' });
  const key = `${year}-${monthNumber}`;

  if (!archiveMap.has(key)) {
    archiveMap.set(key, {
      id: `arquivo-${year}-${monthNumber}`,
      label: `${year} - ${monthLabel}`,
      posts: [],
    });
  }

  archiveMap.get(key)?.posts.push(post);
}

const archiveBuckets = [...archiveMap.values()];
const navItems = archiveBuckets.map((bucket) => ({ depth: 1, slug: bucket.id, text: bucket.label }));

const ranks = new Map<string, string>();
let rankCounter = 142;

for (const post of posts) {
  ranks.set(post.id, `#${String(rankCounter++).padStart(4, '0')}`);
}
---

<section class="home-archive" id="topo">
  <aside class="rail sticky-rail">
    <InPageNav items={navItems} title={language === 'en' ? 'in this page' : 'nesta página'} includeTopLevel={true} />
  </aside>

  <article class="timeline">
    {archiveBuckets.map((bucket) => (
      <section class="archive-block" id={bucket.id}>
        <h2>{bucket.label}</h2>

        <div class="list">
          {bucket.posts.map((post) => (
              <PostCard
                rank={ranks.get(post.id) ?? '#0000'}
                href={getPostPath(post)}
                title={post.data.title}
                summary={post.data.summary}
                publishDate={post.data.publishDate}
              tags={post.data.tags}
              readingMinutes={Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 220))}
              language={post.data.language}
            />
          ))}
        </div>
      </section>
    ))}
  </article>
</section>

<style>
  .home-archive {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .rail {
    min-width: 0;
  }

  .timeline {
    display: grid;
    gap: 1.4rem;
  }

  .archive-block {
    display: grid;
    gap: 0.7rem;
  }

  .archive-block h2 {
    margin: 0;
  }

  .archive-block h2 {
    color: var(--accent);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    scroll-margin-top: 6rem;
  }

  .list {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.2rem;
  }

  @media (min-width: 921px) {
    .sticky-rail {
      top: 8rem;
      max-height: calc(100vh - 9rem);
    }
  }

  @media (max-width: 920px) {
    .home-archive {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .rail {
      height: 0;
      margin: 0;
    }
  }

</style>
