---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  items?: HeadingItem[];
  headings?: HeadingItem[];
  title?: string;
  includeTopLevel?: boolean;
}

const { items: providedItems, headings = [], title = 'nesta página', includeTopLevel = false } = Astro.props;

const navItems = [
  { slug: 'topo', text: 'Topo', depth: 1 },
  ...(providedItems ?? headings).filter((heading) => (includeTopLevel ? heading.depth >= 1 : heading.depth >= 2)),
];
---

<nav class="toc surface" aria-label={title}>
  <div class="toc-head">
    <span class="eyebrow">{title}</span>
  </div>

  <ul>
    {navItems.map((item) => (
      <li class:list={[item.depth > 2 && 'indent']}>
        <a href={`#${item.slug}`}>{item.text}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc {
    padding: 0.95rem;
  }

  .toc-head {
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: block;
    padding: 0.3rem 0.1rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  a:hover,
  a:focus-visible {
    color: var(--accent);
  }

  .indent a {
    padding-left: 0.75rem;
  }

</style>
