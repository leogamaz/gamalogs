  }

  .hero-version {
    margin-top: 40px;
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    animation: fadeSlideDown 0.6s 0.3s ease both;
  }

  .hero-version span { color: var(--accent4); }

  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 11px;
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.1em;
    animation: fadeSlideDown 0.6s 0.5s ease both;
  }

  .scroll-arrow {
    width: 24px; height: 24px;
    border: 1.5px solid var(--muted);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    animation: bounce 2s infinite;
  }

  /* LAYERS */
  .layers-section {
    position: relative;
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
    max-width: 200px;
  }

  .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 48px;
    line-height: 1.1;
  }

  .layers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    border-radius: 20px;
    overflow: hidden;
  }

  .layer-card {
    background: var(--surface);
    padding: 40px 36px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }
  .layer-card:hover { background: var(--surface2); }
  .layer-card::before {
    content: attr(data-num);
    position: absolute;
    top: -20px; right: 20px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 120px;
    font-weight: 800;
    color: rgba(255,255,255,0.02);
    line-height: 1;
    pointer-events: none;
  }

  .layer-tag {
    display: inline-block;
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .layer-tag.terminal { background: rgba(255,214,102,0.1); color: var(--accent4); border: 1px solid rgba(255,214,102,0.2); }
  .layer-tag.agent { background: rgba(79,255,176,0.1); color: var(--accent); border: 1px solid rgba(79,255,176,0.2); }

  .layer-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .layer-code {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--accent4);
    background: var(--code-bg);
    padding: 8px 14px;
    border-radius: 6px;
    margin-top: 16px;
    border-left: 2px solid var(--accent4);
    word-break: break-all;
  }
  .layer-card.agent-layer .layer-code { color: var(--accent); border-color: var(--accent); }

  /* MAIN FLOW */
  .flow-section {
    position: relative;
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .flow-timeline {
    position: relative;
    margin-top: 16px;
  }

  .flow-timeline::before {
    content: '';
    position: absolute;
    left: 32px;
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--accent2), var(--accent3));
    opacity: 0.3;
  }

  .flow-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0 24px;
    margin-bottom: 4px;
    position: relative;
  }

  .flow-step-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 24px;
  }

  .step-dot {
    width: 16px; height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    box-shadow: 0 0 16px var(--glow);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .flow-item:hover .step-dot {
    transform: scale(1.4);
    box-shadow: 0 0 24px var(--accent);
  }

  .flow-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 4px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    cursor: default;
  }

  .flow-card:hover {
    border-color: rgba(79,255,176,0.25);
    background: var(--surface2);
    transform: translateX(6px);
    box-shadow: -4px 0 0 var(--accent), 0 16px 48px rgba(0,0,0,0.3);
  }

  .flow-card-inner { position: relative; z-index: 1; }

  .flow-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .cmd-pill {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .flow-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 200px;
  }

  .flow-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
  }

  .flow-timing {
    font-size: 12px;
    color: var(--muted);
    font-style: italic;
  }

  .flow-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }

  .flow-col h4 {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
    font-family: 'Geist Mono', monospace;
    font-weight: 400;
  }

  .flow-col p {
    font-size: 13.5px;
    line-height: 1.6;
    color: #c0c4d4;
  }

  .flow-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .flow-col ul li {
    font-size: 13px;
    color: #c0c4d4;
    padding-left: 14px;
    position: relative;
    line-height: 1.5;
  }

  .flow-col ul li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 10px;
  }

  .code-example {
    margin-top: 16px;
    background: var(--code-bg);
    border-radius: 10px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.02);
  }

  .code-dot { width: 8px; height: 8px; border-radius: 50%; }
  .code-dot-r { background: #ff6b6b; }
  .code-dot-y { background: var(--accent4); }
  .code-dot-g { background: var(--accent); }

  .code-filename {
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    color: var(--muted);
    margin-left: 4px;
  }

  .code-body {
    padding: 16px;
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    line-height: 1.8;
    color: #9aa3c0;
    white-space: pre-wrap;
    overflow-x: auto;
    word-break: break-word;
  }

  .code-body .cmd { color: var(--accent); font-weight: 700; }
  .code-body .comment { color: #4a5270; }
  .code-body .str { color: var(--accent4); }
  .code-body .kw { color: var(--accent2); }

  .output-files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .output-file {
    font-family: 'Geist Mono', monospace;
    font-size: 10.5px;
    padding: 3px 10px;
    border-radius: 4px;
    background: rgba(79,255,176,0.06);
    color: var(--accent);
    border: 1px solid rgba(79,255,176,0.15);
  }

  .model-rec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 4px;
    background: rgba(124,109,250,0.1);
    color: var(--accent2);
    border: 1px solid rgba(124,109,250,0.2);
    font-family: 'Geist Mono', monospace;
    margin-top: 10px;
  }

  .thinking-bar { display: flex; gap: 3px; align-items: center; }
  .thinking-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent2); opacity: 0.3; }
  .thinking-dot.on { opacity: 1; box-shadow: 0 0 6px var(--accent2); }

  /* TERMINAL */
  .terminal-section {
    position: relative;
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .terminal-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: 2px;
    flex-wrap: wrap;
  }

  .tab-btn {
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    padding: 8px 20px;
    border-radius: 8px 8px 0 0;
    border: 1px solid var(--border);
    border-bottom: none;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .tab-btn:hover { background: var(--surface2); color: var(--text); }
  .tab-btn.active { background: var(--surface2); color: var(--accent); border-color: rgba(79,255,176,0.2); }

  .tab-panel {
    display: none;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 0 12px 12px 12px;
    overflow: hidden;
  }
  .tab-panel.active { display: block; }

  .cmd-table { width: 100%; border-collapse: collapse; }
  .cmd-table thead tr { background: var(--code-bg); }
  .cmd-table th {
    padding: 12px 20px;
    text-align: left;
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
    border-bottom: 1px solid var(--border);
  }
  .cmd-table td {
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    vertical-align: top;
  }
  .cmd-table tr:last-child td { border-bottom: none; }
  .cmd-table tr:hover td { background: rgba(255,255,255,0.02); }
  .cmd-mono { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--accent4); line-height: 1.6; word-break: break-all; }
  .cmd-desc { color: #b0b8cc; }

  /* GOLDEN */
  .golden-section {
    position: relative;
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .golden-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 40px;
  }

  .golden-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    flex: 1;
    min-width: 90px;
    padding: 20px 8px;
    border-radius: 12px;
    transition: all 0.25s;
    position: relative;
  }

  .golden-step:hover { background: rgba(255,255,255,0.04); transform: translateY(-4px); }

  .step-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
  }

  .step-name { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--accent); letter-spacing: 0.05em; }
  .step-desc { font-size: 11px; color: var(--muted); line-height: 1.4; max-width: 80px; }

  .step-arrow { color: var(--muted); font-size: 16px; padding: 0 4px; margin-top: -20px; flex-shrink: 0; }

  .warning-box {
    background: rgba(255,107,107,0.06);
    border: 1px solid rgba(255,107,107,0.2);
    border-radius: 14px;
    padding: 24px 28px;
    margin-top: 48px;
    position: relative;
    overflow: hidden;
  }
  .warning-box::before {
    content: '⚠';
    position: absolute;
    top: -20px; right: 20px;
    font-size: 100px;
    opacity: 0.04;
    line-height: 1;
  }
  .warning-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--accent3);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .warning-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .warning-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    color: #c0c4d4;
  }
  .warning-list li::before { content: '✗'; color: var(--accent3); flex-shrink: 0; font-weight: 700; }

  .pattern-box {
    background: rgba(79,255,176,0.04);
    border: 1px solid rgba(79,255,176,0.15);
    border-radius: 14px;
    padding: 28px 32px;
    margin-top: 32px;
  }
  .pattern-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  footer {
    position: relative;
    text-align: center;
    padding: 60px 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
  }
  footer span { color: var(--accent); }

  @keyframes fadeSlideDown {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  @keyframes bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* COLOR SCHEMES PER STEP */
  .c-constitution { --step-color: #ffd166; }
  .c-specify      { --step-color: #4fffb0; }
  .c-clarify      { --step-color: #a8edea; }
  .c-checklist    { --step-color: #7c6dfa; }
  .c-plan         { --step-color: #f7b731; }
  .c-tasks        { --step-color: #ff6b6b; }
  .c-analyze      { --step-color: #fd9644; }
  .c-implement    { --step-color: #26de81; }
  .c-t2i          { --step-color: #a29bfe; }

  .flow-card.c-constitution:hover { border-color: rgba(255,209,102,0.35); box-shadow: -4px 0 0 #ffd166, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-specify:hover      { border-color: rgba(79,255,176,0.35);  box-shadow: -4px 0 0 #4fffb0, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-clarify:hover      { border-color: rgba(168,237,234,0.35); box-shadow: -4px 0 0 #a8edea, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-checklist:hover    { border-color: rgba(124,109,250,0.35); box-shadow: -4px 0 0 #7c6dfa, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-plan:hover         { border-color: rgba(247,183,49,0.35);  box-shadow: -4px 0 0 #f7b731, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-tasks:hover        { border-color: rgba(255,107,107,0.35); box-shadow: -4px 0 0 #ff6b6b, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-analyze:hover      { border-color: rgba(253,150,68,0.35);  box-shadow: -4px 0 0 #fd9644, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-implement:hover    { border-color: rgba(38,222,129,0.35);  box-shadow: -4px 0 0 #26de81, 0 16px 48px rgba(0,0,0,0.3); }
  .flow-card.c-t2i:hover          { border-color: rgba(162,155,254,0.35); box-shadow: -4px 0 0 #a29bfe, 0 16px 48px rgba(0,0,0,0.3); }

  .flow-item:hover .step-dot { border-color: var(--step-color); box-shadow: 0 0 20px var(--step-color); }
  .cmd-pill { background: rgba(255,255,255,0.05); color: var(--step-color); border: 1px solid rgba(255,255,255,0.1); }
  .step-icon { background: rgba(255,255,255,0.04); }

  /* NAV STICKY */
  .sticky-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    height: 52px;
    background: rgba(8,11,18,0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
    transition: transform 0.3s ease;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2px;
    width: 100%;
    max-width: 1100px;
  }
  .nav-logo {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-right: 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-sep { width: 1px; height: 20px; background: var(--border); margin-right: 12px; flex-shrink: 0; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar { display: none; }
  .nav-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    padding: 5px 11px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s;
    white-space: nowrap;
    border: 1px solid transparent;
    background: none;
    text-decoration: none;
    display: block;
  }
  .nav-link:hover { color: var(--text); background: rgba(255,255,255,0.05); }
  .nav-link.active { color: var(--accent); background: rgba(79,255,176,0.08); border-color: rgba(79,255,176,0.2); }
  section[id] { scroll-margin-top: 64px; }

  /* QUICK STRIP */
  .quick-strip { position: relative; z-index: 1; padding: 0 24px 64px; }
  .quick-strip-inner { max-width: 900px; margin: 0 auto; }
  .quick-strip-label {
    text-align: center;
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .quick-grid { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .quick-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    font-weight: 400;
    transition: all 0.2s cubic-bezier(0.23,1,0.32,1);
    cursor: pointer;
    white-space: nowrap;
  }
  .quick-btn:hover { background: var(--surface2); color: var(--text); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
  .quick-btn .qi { font-size: 14px; line-height: 1; flex-shrink: 0; }
  .quick-btn .ql { color: inherit; opacity: 0.7; transition: opacity 0.2s; }
  .quick-btn:hover .ql { opacity: 1; }

  .quick-btn[data-cmd="constitution"] { --qc: #ffd166; }
  .quick-btn[data-cmd="specify"]      { --qc: #4fffb0; }
  .quick-btn[data-cmd="clarify"]      { --qc: #a8edea; }
  .quick-btn[data-cmd="checklist"]    { --qc: #7c6dfa; }
  .quick-btn[data-cmd="plan"]         { --qc: #f7b731; }
  .quick-btn[data-cmd="tasks"]        { --qc: #ff6b6b; }
  .quick-btn[data-cmd="analyze"]      { --qc: #fd9644; }
  .quick-btn[data-cmd="implement"]    { --qc: #26de81; }
  .quick-btn[data-cmd="t2i"]          { --qc: #a29bfe; }
  .quick-btn:hover { border-color: color-mix(in srgb, var(--qc) 40%, transparent); color: var(--qc); box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 1px color-mix(in srgb, var(--qc) 20%, transparent); }
  .quick-btn:hover .ql { color: var(--qc); opacity: 0.7; }

  /* QUANDO USAR */
  .when-usar {
    margin-top: 16px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }
  .when-usar-col h4 {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
    font-family: 'Geist Mono', monospace;
    font-weight: 400;
  }
  .when-usar-col ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .when-usar-col ul li { font-size: 13px; color: #b0b8cc; padding-left: 16px; position: relative; line-height: 1.5; }
  .when-usar-col ul li.usual::before { content: '●'; position: absolute; left: 0; color: var(--step-color, var(--accent)); font-size: 7px; top: 5px; }
