---
import { archivePath, guidesPath, homePath, pagePath } from '../lib/routes';

const language = Astro.url.pathname.startsWith('/en') ? 'en' : 'pt';

// Conteúdo demonstrativo: troque estes textos e URLs pelos dados reais do blog.
const content = language === 'en'
  ? {
      label: 'Site footer',
      description: 'Small notes, practical experiments, and ideas worth keeping.',
      navigation: 'Explore',
      links: [
        { label: 'Home', href: homePath('en') },
        { label: 'Archive', href: archivePath('en') },
        { label: 'Guides', href: guidesPath('en') },
        { label: 'About', href: pagePath('about', 'en') },
      ],
      elsewhere: 'Elsewhere',
      instagram: 'Instagram',
      github: 'GitHub',
      note: 'Short notes, practical experiments, and things I’m learning',
    }
  : { 
      label: 'Rodapé do site',
      description: 'Notas curtas, experimentos práticos e aprendizados que compartilho.',
      navigation: 'Explorar',
      links: [
        { label: 'Início', href: homePath('pt') },
        { label: 'Arquivo', href: archivePath('pt') },
        { label: 'Guias', href: guidesPath('pt') },
        { label: 'Sobre', href: pagePath('sobre', 'pt') },
      ],
      elsewhere: 'Por aí',
      instagram: 'Instagram',
      github: 'GitHub',
      note: 'Feito com curiosidade, uma nota por vez.',
    };

const socialLinks = [
  // URLs demonstrativas: substitua pelos perfis oficiais antes de publicar.
  { label: content.instagram, href: 'https://www.instagram.com/leo.gamaz/' },
  { label: content.github, href: 'https://github.com/leogamaz' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-intro">
      <a class="footer-brand" href={homePath(language)} aria-label={`Gama Logs — ${content.links[0].label}`}>
        <span class="prompt" aria-hidden="true">~/</span><strong>gamalogs</strong>
      </a>
      <p>{content.description}</p>
    </div>

    <nav class="footer-nav" aria-label={content.navigation}>
      <h2>{content.navigation}</h2>
      <ul>
        {content.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-nav" aria-label={content.elsewhere}>
      <h2>{content.elsewhere}</h2>
      <ul>
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}<span aria-hidden="true"> ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Gama Logs</span>
    <span>{content.note}</span>
  </div>
</footer>

<style>
  .site-footer {
    width: min(calc(100% - 2rem), var(--content));
    margin: 3rem auto 0;
    padding: 2.4rem 0 1.15rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(14rem, 1.8fr) repeat(2, minmax(7rem, 1fr));
    gap: 2rem;
  }

  .footer-brand {
    display: inline-flex;
    gap: 0.35rem;
    color: var(--text);
    text-decoration: none;
    font-size: 1.05rem;
  }

  .prompt {
    color: var(--accent);
  }

  .footer-intro p {
    max-width: 25rem;
    margin: 0.75rem 0 0;
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .footer-nav h2 {
    margin: 0 0 0.7rem;
    color: var(--text);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-nav ul {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.82rem;
  }

  .footer-nav a {
    display: inline-block;
    padding: 0.14rem 0;
    text-decoration: none;
    transition: color 140ms ease, transform 140ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    color: var(--accent);
    transform: translateX(0.18rem);
  }

  .footer-nav a:focus-visible,
  .footer-brand:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.25rem;
    border-radius: 0.15rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.68rem;
  }

  @media (max-width: 720px) {
    .site-footer {
      width: min(calc(100% - 1rem), var(--content));
      margin-top: 2rem;
      padding-top: 1.8rem;
    }

    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1rem;
    }

    .footer-intro {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: 1.8rem;
    }
  }

  @media (max-width: 399px) {
    .site-footer {
      width: min(calc(100% - 0.75rem), var(--content));
      padding-bottom: 0.75rem;
    }

    .footer-inner {
      gap: 1.25rem 0.75rem;
    }
  }
</style>
